# Copy this file to .env on the VPS. Never commit the real .env file.
ADMIN_USERNAME=Ekaterina-admin
# Generate with: npm run admin:password
ADMIN_PASSWORD_HASH=
# Generate a long random value: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Use an absolute, persistent path on the VPS outside the release directory.
DATABASE_PATH=/var/lib/trofik/trofik.sqlite
UPLOADS_DIR=/var/lib/trofik/uploads

# Боевой адрес сайта — используется в canonical, sitemap.xml и robots.txt.
# Без него берётся https://trofik.ru
SITE_URL=https://trofik.ru
